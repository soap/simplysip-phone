#!/usr/bin/env bash
# The seven rules of a great commit message (Chris Beams), as in sip-manager's CaptainHook:
# subject <= 50 characters, capitalised, no trailing period, blank second line, body lines <= 72.
set -euo pipefail
export LC_ALL=C.UTF-8 # count characters, not bytes (Thai text)

file="$1"
mapfile -t lines < <(grep -v '^#' "$file" | sed 's/\r$//')

# Drop trailing blank lines; nothing left means git aborts the commit anyway.
while ((${#lines[@]})) && [[ -z "${lines[-1]// /}" ]]; do unset 'lines[-1]'; done
((${#lines[@]})) || exit 0

subject="${lines[0]}"
# Messages generated by git itself.
[[ "$subject" =~ ^(Merge|Revert|fixup!|squash!|amend!) ]] && exit 0

errors=()
((${#subject} <= 50)) || errors+=("subject is ${#subject} characters (max 50)")
[[ "$subject" =~ ^[[:lower:]] ]] && errors+=("subject must start with a capital letter")
[[ "$subject" == *. ]] && errors+=("subject must not end with a period")
if ((${#lines[@]} > 1)) && [[ -n "${lines[1]}" ]]; then
    errors+=("second line must be blank")
fi
for ((i = 2; i < ${#lines[@]}; i++)); do
    line="${lines[i]}"
    # Long URLs cannot be wrapped.
    [[ "$line" =~ https?:// ]] && continue
    ((${#line} <= 72)) || errors+=("body line $((i + 1)) is ${#line} characters (max 72)")
done

if ((${#errors[@]})); then
    echo "commit-msg:" >&2
    printf '  - %s\n' "${errors[@]}" >&2
    echo "Your message was kept in .git/COMMIT_EDITMSG." >&2
    exit 1
fi
